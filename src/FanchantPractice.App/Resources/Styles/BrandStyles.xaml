<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
  <Color x:Key="BackgroundBase">#121212</Color><Color x:Key="BackgroundSurface">#1B1B1D</Color><Color x:Key="BackgroundCard">#242428</Color><Color x:Key="BrandGray">#A9A9A9</Color>
  <Color x:Key="TextPrimary">#F5F5F5</Color><Color x:Key="TextSecondary">#B9B9C0</Color><Color x:Key="BorderDefault">#37373D</Color>
  <Color x:Key="MemberDoojoon">#5794FF</Color><Color x:Key="MemberYoseob">#FFD75A</Color><Color x:Key="MemberGikwang">#57C785</Color><Color x:Key="MemberDongwoon">#A87CFF</Color>
  <Style TargetType="ContentPage"><Setter Property="BackgroundColor" Value="{StaticResource BackgroundBase}"/><Setter Property="Shell.NavBarIsVisible" Value="False"/></Style>
  <Style x:Key="TitleStyle" TargetType="Label"><Setter Property="FontSize" Value="24"/><Setter Property="FontAttributes" Value="Bold"/><Setter Property="TextColor" Value="{StaticResource TextPrimary}"/></Style>
  <Style x:Key="SectionTitleStyle" TargetType="Label"><Setter Property="FontSize" Value="20"/><Setter Property="FontAttributes" Value="Bold"/><Setter Property="TextColor" Value="{StaticResource TextPrimary}"/></Style>
  <Style x:Key="BodyStyle" TargetType="Label"><Setter Property="FontSize" Value="16"/><Setter Property="TextColor" Value="{StaticResource TextSecondary}"/></Style>
  <Style x:Key="CaptionStyle" TargetType="Label"><Setter Property="FontSize" Value="12"/><Setter Property="TextColor" Value="{StaticResource TextSecondary}"/></Style>
  <Style x:Key="CardStyle" TargetType="Border"><Setter Property="BackgroundColor" Value="{StaticResource BackgroundCard}"/><Setter Property="Padding" Value="16"/><Setter Property="Stroke" Value="{StaticResource BorderDefault}"/><Setter Property="StrokeShape" Value="RoundRectangle 16"/></Style>
  <Style x:Key="MemberChipStyle" TargetType="Border"><Setter Property="Padding" Value="12,8"/><Setter Property="StrokeThickness" Value="0"/><Setter Property="StrokeShape" Value="RoundRectangle 999"/></Style>
  <Style x:Key="PrimaryButtonStyle" TargetType="Button"><Setter Property="HeightRequest" Value="52"/><Setter Property="BackgroundColor" Value="{StaticResource BrandGray}"/><Setter Property="TextColor" Value="#121212"/><Setter Property="FontAttributes" Value="Bold"/><Setter Property="CornerRadius" Value="12"/></Style>
  <Style x:Key="TextButtonStyle" TargetType="Button"><Setter Property="BackgroundColor" Value="Transparent"/><Setter Property="TextColor" Value="{StaticResource TextSecondary}"/></Style>
</ResourceDictionary>
