<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FanchantPractice.App.Views.HomePage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:FanchantPractice.App.ViewModels" x:DataType="vm:HomeViewModel" Title="홈">
  <ScrollView><VerticalStackLayout Padding="20,24,20,32" Spacing="24">
    <VerticalStackLayout Spacing="4"><Label Text="{Binding Greeting}" Style="{StaticResource TitleStyle}"/><Label Text="콘서트 전에 셋리스트를 차근차근 연습해 보세요." Style="{StaticResource BodyStyle}"/></VerticalStackLayout>
    <Border Style="{StaticResource CardStyle}"><VerticalStackLayout Spacing="12"><Label Text="다가오는 콘서트" Style="{StaticResource SectionTitleStyle}"/><Label Text="등록된 콘서트가 없습니다." Style="{StaticResource BodyStyle}"/><Label Text="셋리스트가 준비되면 이곳에서 바로 연습할 수 있습니다." Style="{StaticResource CaptionStyle}"/></VerticalStackLayout></Border>
    <Border Style="{StaticResource CardStyle}"><VerticalStackLayout Spacing="16"><Label Text="멤버 상징색" Style="{StaticResource SectionTitleStyle}"/><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8"><Border BackgroundColor="{StaticResource MemberDoojoon}" Style="{StaticResource MemberChipStyle}"><Label Text="윤두준" TextColor="#121212"/></Border><Border Grid.Column="1" BackgroundColor="{StaticResource MemberYoseob}" Style="{StaticResource MemberChipStyle}"><Label Text="양요섭" TextColor="#121212"/></Border><Border Grid.Row="1" BackgroundColor="{StaticResource MemberGikwang}" Style="{StaticResource MemberChipStyle}"><Label Text="이기광" TextColor="#121212"/></Border><Border Grid.Row="1" Grid.Column="1" BackgroundColor="{StaticResource MemberDongwoon}" Style="{StaticResource MemberChipStyle}"><Label Text="손동운" TextColor="#121212"/></Border></Grid></VerticalStackLayout></Border>
    <Button Text="곡에서 연습 시작" Command="{Binding StartPracticeCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
  </VerticalStackLayout></ScrollView>
</ContentPage>
