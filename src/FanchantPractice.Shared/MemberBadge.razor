@using Microsoft.AspNetCore.Components
<span class="member-badge" style="--member-color:@Color"><span class="member-heart" aria-hidden="true">♥</span><span>@Name</span></span>
@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Color { get; set; } = "#A9A9A9";
}
